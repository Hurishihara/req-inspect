{
  "name": "req-inspect-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter @req-inspect/core build && bun run --filter @req-inspect/dashboard build && bun run --filter @req-inspect/express build",
    "test": "bun test packages/*/test",
    "test:int": "node --test packages/express/test/integration/*.int.mjs",
    "typecheck": "tsc -p packages/core && tsc -p packages/express && tsc -p packages/dashboard",
    "check:pkg": "node scripts/check-no-workspace-protocol.mjs && publint packages/core && publint packages/express && attw --pack packages/core && attw --pack packages/express",
    "release": "bun run build && changeset publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
