{
  "name": "@req-inspect/core",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hurishihara/req-inspect.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Hurishihara/req-inspect#readme",
  "bugs": {
    "url": "https://github.com/Hurishihara/req-inspect/issues"
  },
  "keywords": [
    "req-inspect",
    "request",
    "inspector",
    "debug",
    "http"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
