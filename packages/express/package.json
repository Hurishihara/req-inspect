{
  "name": "@req-inspect/express",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@req-inspect/core": "^0.3.0"
  },
  "peerDependencies": {
    "express": "^4.18 || ^5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express4": "npm:express@^4.21",
    "express5": "npm:express@^5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hurishihara/req-inspect.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/Hurishihara/req-inspect#readme",
  "bugs": {
    "url": "https://github.com/Hurishihara/req-inspect/issues"
  },
  "keywords": [
    "req-inspect",
    "request",
    "inspector",
    "debug",
    "express",
    "middleware"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
